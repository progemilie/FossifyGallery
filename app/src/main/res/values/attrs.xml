<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="SettingsCard">
        <!-- the section's name, which is all the card shows of itself when it is shut -->
        <attr name="cardTitle" format="reference|string" />
        <!-- the line under it saying what is inside, which the settings replace once it opens -->
        <attr name="cardDescription" format="reference|string" />
        <!-- the glyph beside the name, there to be recognised before the name is read -->
        <attr name="cardIcon" format="reference" />
    </declare-styleable>

    <declare-styleable name="FolderCoverView">
        <!-- the cover's height over its width; left out, the cover is square -->
        <attr name="coverAspectRatio" format="float" />
        <!-- rounds the cover by its outline rather than by cutting the bitmap -->
        <attr name="coverCornerRadius" format="dimension" />
        <!-- the sibling laid over the cover, whose area the cover frosts -->
        <attr name="frostBehind" format="reference" />
    </declare-styleable>

    <declare-styleable name="FolderStackCards">
        <!-- the cover the cards sit under, whose picture they take after -->
        <attr name="stackCover" format="reference" />
    </declare-styleable>
</resources>
