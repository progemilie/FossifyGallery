<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="SettingsPage">
        <!-- the page's name: its heading, and the bar's title once that has scrolled away -->
        <attr name="pageTitle" format="reference|string" />
        <!-- the colour the page's icons wear, and the badge of the link that opens it -->
        <attr name="pageHue" format="reference|color" />
    </declare-styleable>

    <declare-styleable name="SettingsGroup">
        <!-- the heading over the group; a group can do without -->
        <attr name="groupTitle" format="reference|string" />
    </declare-styleable>

    <declare-styleable name="SettingsLink">
        <!-- the SettingsPage it opens, whose title and hue it wears -->
        <attr name="opens" format="reference" />
        <attr name="linkIcon" format="reference" />
        <attr name="linkSummary" format="reference|string" />
    </declare-styleable>

    <declare-styleable name="FolderCoverView">
        <!-- the cover's height over its width; left out, the cover is square -->
        <attr name="coverAspectRatio" format="float" />
        <!-- rounds the cover by its outline rather than by cutting the bitmap -->
        <attr name="coverCornerRadius" format="dimension" />
        <!-- the sibling laid over the cover, whose area the cover frosts -->
        <attr name="frostBehind" format="reference" />
    </declare-styleable>

    <declare-styleable name="FolderStackCards">
        <!-- the cover the cards sit under, whose picture they take after -->
        <attr name="stackCover" format="reference" />
    </declare-styleable>
</resources>
