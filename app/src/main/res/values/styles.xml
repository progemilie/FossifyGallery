<resources>

    <style name="AppTheme" parent="AppTheme.Base" />

    <!-- the settings screen: pages of rounded groups of rows, see org.fossify.gallery.views.SettingsGroup -->
    <!-- the first page's scroller, and the one the other pages share; see SettingsPages -->
    <style name="SettingsScroller">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:fillViewport">true</item>
        <item name="android:scrollbars">none</item>
    </style>

    <!-- what a scroller scrolls: a page's name, then the page -->
    <style name="SettingsScrollerContent" parent="SettingsPage">
        <item name="android:clipToPadding">false</item>
        <item name="android:paddingBottom">@dimen/bottom_fade_height</item>
    </style>

    <style name="SettingsPage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingsPageTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/settings_page_title_margin</item>
        <item name="android:paddingTop">@dimen/settings_page_title_top</item>
        <item name="android:paddingEnd">@dimen/settings_page_title_margin</item>
        <item name="android:paddingBottom">@dimen/settings_page_title_bottom</item>
        <item name="android:textSize">@dimen/settings_page_title_text_size</item>
    </style>

    <!-- written on the page like a settings page's title, in line with the folder tiles below it, at
         the size the picker's toolbar title had -->
    <style name="FolderPickerTitle" parent="SettingsPageTitle">
        <item name="android:paddingStart">@dimen/activity_margin</item>
        <item name="android:paddingEnd">@dimen/activity_margin</item>
        <item name="android:textSize">@dimen/actionbar_text_size</item>
    </style>

    <style name="SettingsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/settings_group_margin</item>
        <item name="android:layout_marginEnd">@dimen/settings_group_margin</item>
        <item name="android:layout_marginBottom">@dimen/settings_group_gap</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/settings_row_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/settings_row_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/settings_row_padding_vertical</item>
        <item name="android:paddingEnd">@dimen/settings_row_padding_horizontal</item>
        <item name="android:paddingBottom">@dimen/settings_row_padding_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- a row's first child, which its group tints with the page's hue -->
    <style name="SettingsRowIcon">
        <item name="android:layout_width">@dimen/settings_row_icon_size</item>
        <item name="android:layout_height">@dimen/settings_row_icon_size</item>
        <item name="android:layout_marginEnd">@dimen/settings_row_icon_gap</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="SettingsRowTexts">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/bigger_text_size</item>
    </style>

    <!-- a title alone in its row, taking the room a column of texts would -->
    <style name="SettingsRowLabel" parent="SettingsRowTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="SettingsRowSummary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/settings_row_summary_gap</item>
        <item name="android:alpha">0.7</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <!-- the switch is the row's title too, its thumb at the row's end; the row takes the tap -->
    <style name="SettingsRowSwitch">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@null</item>
        <item name="android:clickable">false</item>
        <item name="android:textSize">@dimen/bigger_text_size</item>
    </style>

    <style name="VideoTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:shadowColor">@color/default_background_color</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <style name="VideoToggle">
        <item name="android:layout_width">@dimen/video_toggle_size</item>
        <item name="android:layout_height">@dimen/video_toggle_size</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/video_toggle_padding</item>
    </style>

    <style name="VideoSeekHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:alpha">0</item>
        <item name="android:background">@drawable/playback_pill_background</item>
        <item name="android:drawablePadding">@dimen/tiny_margin</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/activity_margin</item>
        <item name="android:paddingVertical">@dimen/medium_margin</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="FullScreenTheme.Base" parent="AppTheme">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="FullScreenTheme" parent="FullScreenTheme.Base" />
    <!--
        The fullscreen viewers. Opaque here and see-through in values-v28, where the tile flight
        draws a photo growing out of the grid still drawn behind it.

        The window animation is nothing at all on purpose: naming one in ActivityOptions instead is
        what the system takes as licence to drop the grid's window from the frame, leaving the photo
        growing out of black. See ViewerTransition.
    -->
    <style name="ViewerTheme.Base" parent="TranslucentTheme">
        <item name="android:windowAnimationStyle">@style/ViewerWindowAnimation</item>
    </style>

    <style name="ViewerTheme" parent="ViewerTheme.Base" />

    <style name="ViewerWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/viewer_hold</item>
        <item name="android:activityOpenExitAnimation">@anim/viewer_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/viewer_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/viewer_hold</item>
    </style>

    <!--
        The folder picker: a dialog filling the screen. Its content is inflated with the activity's own
        theme, so this carries only what the window itself needs. See PickDirectoryDialog.
    -->
    <style name="FullscreenDialog" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/FullscreenDialogAnimation</item>
    </style>

    <style name="FullscreenDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/fullscreen_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/fullscreen_dialog_exit</item>
    </style>
</resources>
