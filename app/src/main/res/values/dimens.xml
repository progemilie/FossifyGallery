    <!-- the strip of thumbnails between the photo and the bottom actions in the viewer. The item is
         wider than the thumbnail on purpose: the gap either side is what the shrunken off-centre
         thumbnails grow into, so nothing has to overflow its own cell to look bigger -->
    <dimen name="viewer_strip_thumbnail_size">40dp</dimen>
    <dimen name="viewer_strip_item_width">42dp</dimen>
    <dimen name="viewer_strip_padding_top">10dp</dimen>
    <dimen name="viewer_strip_padding_bottom">2dp</dimen>
    <dimen name="viewer_strip_height">54dp</dimen>

    <dimen name="bottom_fade_height">60dp</dimen>
    <dimen name="top_fade_height">70dp</dimen>
    <!-- how far the search pill sits off the grid. Small on purpose: an elevation shadow's spread
         grows with it, and this one wants a quick falloff hugging the pill rather than a halo -->
    <dimen name="search_pill_elevation">3dp</dimen>
    <!-- a real drag down to pan the bar away, the smallest nudge back up to bring it in again -->
    <dimen name="top_bar_hide_threshold">200dp</dimen>
    <dimen name="top_bar_show_threshold">8dp</dimen>
    <!-- how far below the floating bar a pull to refresh spinner comes to rest -->
    <dimen name="refresh_spinner_travel">64dp</dimen>
