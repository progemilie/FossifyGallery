<?xml version="1.0" encoding="utf-8"?>
<!--
    No motion at all. The viewer's own transition draws the tile growing into the photo and back
    again; any window animation over the top of that would slide or fade a second copy of the whole
    screen through it. See ViewerTransition.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="0"
    android:fromAlpha="1.0"
    android:toAlpha="1.0" />
