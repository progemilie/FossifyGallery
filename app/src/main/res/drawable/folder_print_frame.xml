<?xml version="1.0" encoding="utf-8"?>
<!-- a print is white whatever the theme, and edged so it still reads on a white background -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners android:radius="@dimen/folder_print_corner" />
    <stroke
        android:width="1px"
        android:color="@color/folder_print_edge" />
</shape>
