<?xml version="1.0" encoding="utf-8"?>
<!-- the Hairline traced around a rounded cover, tinted from the theme where it is bound, see dressFor -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- named outright: a tinted shape with no fill of its own is filled with the tint, over the whole cover -->
    <solid android:color="@android:color/transparent" />
    <corners android:radius="@dimen/rounded_corner_radius_big" />
    <stroke
        android:width="@dimen/hairline_width"
        android:color="@android:color/white" />
</shape>
