<?xml version="1.0" encoding="utf-8"?>
<!--
    Darkens the foot of the grid so the system's navigation buttons stay readable over whatever
    photo happens to be scrolling past under them, instead of standing on a band of solid colour.
    Angle 90 puts the opaque end at the bottom.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- the darkening is kept low down: the centre stop is nearly clear so only the band the
         navigation bar actually sits in loses any of the photo behind it -->
    <gradient
        android:angle="90"
        android:centerColor="#26000000"
        android:endColor="@android:color/transparent"
        android:startColor="#B3000000"
        android:type="linear" />

</shape>
