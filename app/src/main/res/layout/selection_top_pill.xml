<?xml version="1.0" encoding="utf-8"?>
<!--
    What a selection says about itself: the way out of it, and how much is in it. The same pill the
    peek viewer wears in the same corner, so a selection looks the same whether it is being made on
    the grid or looked through fullscreen.

    The outer frame is shadow room and nothing else, the arrangement the navigation pill and the
    drop-down both use: a shadow is drawn outside the view casting it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/selection_top_frame"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/glass_menu_shadow_room"
    android:visibility="gone">

    <org.fossify.gallery.views.GlassPanel
        android:id="@+id/selection_top_panel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/peek_pill_height">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <org.fossify.gallery.views.NavPillSegment
                android:id="@+id/selection_back"
                android:layout_width="@dimen/peek_pill_height"
                android:layout_height="match_parent"
                android:clickable="true"
                android:contentDescription="@string/cancel"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/selection_back_icon"
                    android:layout_width="@dimen/nav_pill_icon_size"
                    android:layout_height="@dimen/nav_pill_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_left_vector" />
            </org.fossify.gallery.views.NavPillSegment>

            <TextView
                android:id="@+id/selection_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/normal_margin"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textSize="@dimen/normal_text_size"
                tools:text="3 / 120" />
        </LinearLayout>
    </org.fossify.gallery.views.GlassPanel>
</FrameLayout>
