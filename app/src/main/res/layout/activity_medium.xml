<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- the strip and the action buttons stack rather than anchor to each other, so either one
         being turned off just closes the gap it left -->
    <LinearLayout
        android:id="@+id/bottom_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <org.fossify.gallery.views.ViewerThumbnailStrip
            android:id="@+id/viewer_thumbnail_strip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/viewer_strip_height"
            android:paddingTop="@dimen/viewer_strip_padding_top"
            android:paddingBottom="@dimen/viewer_strip_padding_bottom"
            android:visibility="gone" />

        <include
            android:id="@+id/bottom_actions"
            layout="@layout/bottom_actions" />

    </LinearLayout>

    <!-- both are nudged horizontally at runtime to sit over whichever spot their button ended up
         in, and only ever one of them is up at a time -->
    <org.fossify.gallery.views.RatingChooser
        android:id="@+id/rating_chooser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_chrome"
        android:layout_marginBottom="@dimen/small_margin"
        android:visibility="gone" />

    <org.fossify.gallery.views.FolderChooser
        android:id="@+id/folder_chooser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_chrome"
        android:layout_marginBottom="@dimen/small_margin"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/top_shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="@dimen/default_status_action_height"
        android:layout_alignBottom="@id/medium_viewer_appbar"
        android:layout_alignParentTop="true"
        android:background="@drawable/gradient_background_flipped"
        android:contentDescription="@null" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/medium_viewer_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/medium_viewer_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:contentInsetStartWithNavigation="0dp"
            app:menu="@menu/menu_viewpager"
            app:navigationIcon="@drawable/ic_arrow_left_vector">

            <include
                android:id="@+id/viewer_header"
                layout="@layout/viewer_header" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- last child so that the sheet draws over the chrome it slides up past -->
    <include
        android:id="@+id/metadata_sheet_holder"
        layout="@layout/metadata_sheet_holder" />

</RelativeLayout>
