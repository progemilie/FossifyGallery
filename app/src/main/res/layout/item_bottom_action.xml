<?xml version="1.0" encoding="utf-8"?>
<!-- One action in the manage-bottom-actions list: grab the handle to move it, tap the row to show or hide it. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_action_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/list_touch_target_min">

    <ImageView
        android:id="@+id/bottom_action_drag_handle"
        android:layout_width="@dimen/list_touch_target_min"
        android:layout_height="@dimen/list_touch_target_min"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/change_order"
        android:padding="@dimen/normal_margin"
        android:src="@drawable/ic_drag_handle_vector" />

    <ImageView
        android:id="@+id/bottom_action_icon"
        android:layout_width="@dimen/list_touch_target_min"
        android:layout_height="@dimen/list_touch_target_min"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/bottom_action_drag_handle"
        android:contentDescription="@null"
        android:padding="@dimen/normal_margin"
        tools:src="@drawable/ic_heart_outline_vector" />

    <org.fossify.commons.views.MyAppCompatCheckbox
        android:id="@+id/bottom_action_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/medium_margin"
        android:clickable="false"
        android:focusable="false" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/bottom_action_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/small_margin"
        android:layout_toStartOf="@+id/bottom_action_checkbox"
        android:layout_toEndOf="@+id/bottom_action_icon"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Toggle favorite" />

</RelativeLayout>
