<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reorder_bar_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/reorder_bar_background"
    android:elevation="@dimen/reorder_bar_elevation"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/medium_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/medium_margin"
    android:paddingBottom="@dimen/medium_margin"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/reorder_move_to_top"
        android:layout_width="@dimen/reorder_button_height"
        android:layout_height="@dimen/reorder_button_height"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reorder_move_to_top"
        android:padding="@dimen/medium_margin"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_move_to_top_vector" />

    <ImageView
        android:id="@+id/reorder_move_to_bottom"
        android:layout_width="@dimen/reorder_button_height"
        android:layout_height="@dimen/reorder_button_height"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reorder_move_to_bottom"
        android:padding="@dimen/medium_margin"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_move_to_bottom_vector" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/reorder_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:layout_marginEnd="@dimen/medium_margin"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/reorder_media_by_dragging"
        android:textSize="@dimen/smaller_text_size" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reorder_cancel"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="@dimen/reorder_button_height"
        android:minWidth="0dp"
        android:paddingStart="@dimen/normal_margin"
        android:paddingEnd="@dimen/normal_margin"
        android:text="@string/cancel"
        app:cornerRadius="@dimen/reorder_button_corner_radius" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reorder_save"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/medium_margin"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="@dimen/reorder_button_height"
        android:minWidth="0dp"
        android:paddingStart="@dimen/bigger_margin"
        android:paddingEnd="@dimen/bigger_margin"
        android:text="@string/save"
        app:cornerRadius="@dimen/reorder_button_corner_radius" />
</LinearLayout>
