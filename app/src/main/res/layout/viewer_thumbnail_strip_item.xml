<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewer_thumbnail_item"
    android:layout_width="@dimen/viewer_strip_item_width"
    android:layout_height="@dimen/viewer_strip_thumbnail_height"
    android:clickable="true"
    android:focusable="true">

    <!-- scaled as a whole so the shade over an unselected thumbnail shrinks along with it, which
         is why it cannot be folded into the cell around it: the cell has to stay the width the
         strip steps by however small the thumbnail inside it is drawn.

         Its background is both the placeholder and the rounded shape the adapter clips it to -->
    <FrameLayout
        android:id="@+id/viewer_thumbnail_holder"
        tools:ignore="UselessParent"
        android:layout_width="@dimen/viewer_strip_thumbnail_width"
        android:layout_height="@dimen/viewer_strip_thumbnail_height"
        android:layout_gravity="center"
        android:background="@drawable/viewer_strip_placeholder">

        <ImageView
            android:id="@+id/viewer_thumbnail_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@mipmap/ic_launcher" />

        <View
            android:id="@+id/viewer_thumbnail_shade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black" />

        <!-- only the peek viewer fills a selection in, so this stays away in the ordinary one -->
        <ImageView
            android:id="@+id/viewer_thumbnail_check"
            android:layout_width="@dimen/viewer_strip_check_size"
            android:layout_height="@dimen/viewer_strip_check_size"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/tiny_margin"
            android:background="@drawable/circle_background"
            android:contentDescription="@null"
            android:padding="1dp"
            android:src="@drawable/ic_check_vector"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

</FrameLayout>
