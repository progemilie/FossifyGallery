<?xml version="1.0" encoding="utf-8"?>
<!--
    Which parts of a file's metadata to take off it. The list of groups is filled in at runtime with
    the ones the file actually carries, so nothing is offered that would do nothing.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/remove_metadata_scrollview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/remove_metadata_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/activity_margin"
        android:paddingTop="@dimen/medium_margin">

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/remove_metadata_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/activity_margin"
            android:text="@string/select_all"
            android:textStyle="bold" />

        <!-- one checkbox per removable group, inflated by the dialog; tinted at runtime -->
        <View
            android:id="@+id/remove_metadata_groups_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/remove_metadata_groups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:id="@+id/remove_metadata_copy_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/remove_metadata_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/activity_margin"
            android:text="@string/metadata_remove_save_copy" />

        <!-- the name the copy would be given, so nobody has to guess where it lands -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/remove_metadata_copy_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/medium_margin"
            android:textSize="@dimen/smaller_text_size"
            android:visibility="gone"
            tools:ignore="TextContrastCheck"
            tools:visibility="visible" />

    </LinearLayout>

</ScrollView>
