<?xml version="1.0" encoding="utf-8"?>
<!--
    One tag. The label keeps a fixed share of the width so that every label in a section lines up
    without a table layout; the value takes the rest and wraps, since a tag value is as long as it
    is and truncating it would be the one thing this screen exists not to do.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/tiny_margin">

    <TextView
        android:id="@+id/metadata_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.38"
        android:paddingEnd="@dimen/small_margin"
        android:textSize="@dimen/normal_text_size"
        tools:ignore="RtlSymmetry,TextContrastCheck"
        tools:text="Date taken" />

    <TextView
        android:id="@+id/metadata_row_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.62"
        android:maxLines="@integer/metadata_value_max_lines"
        android:ellipsize="end"
        android:textSize="@dimen/normal_text_size"
        tools:ignore="TextContrastCheck"
        tools:text="12 Jan 2024, 14:05" />

    <!-- only the description row wears this; it is what says the row can be written as well as read -->
    <ImageView
        android:id="@+id/metadata_row_edit"
        android:layout_width="@dimen/metadata_row_edit_size"
        android:layout_height="@dimen/metadata_row_edit_size"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/edit_description"
        android:src="@drawable/ic_edit_vector"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
