<?xml version="1.0" encoding="utf-8"?>
<!--
    The folder picker's last tile, which makes a new folder. Shaped and spaced like the folder covers
    beside it by NewFolderTileAdapter, which also moves the label onto the outline for the styles
    whose names are written over their covers.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/new_folder_tile"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:contentDescription="@string/create_new_folder"
    android:focusable="true">

    <org.fossify.gallery.views.NewFolderOutline
        android:id="@+id/new_folder_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/new_folder_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/new_folder_outline"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="@dimen/medium_margin"
        android:text="@string/new_folder"
        android:textSize="@dimen/normal_text_size" />

</RelativeLayout>
