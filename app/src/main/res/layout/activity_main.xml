<?xml version="1.0" encoding="utf-8"?>
<!--
    The scaffold both top level grids are shown in. The search bar floats over the top of whichever
    pane is up and the navigation pill over its foot, and neither of them moves when the panes swap
    - only content_holder's two children do. Draw order is what puts the chrome over the content, so
    both come after the holder, the pill last of all.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/directories_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- what the glass copies, and what a pane swap moves inside -->
    <FrameLayout
        android:id="@+id/content_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/directory_pane"
            layout="@layout/pane_directory_grid" />

        <!-- built with the screen but kept out of the layout pass until it is first asked for -->
        <include
            android:id="@+id/media_pane"
            layout="@layout/pane_media_grid"
            android:visibility="gone" />
    </FrameLayout>

    <org.fossify.commons.views.MySearchMenu
        android:id="@+id/main_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/nav_pill"
        layout="@layout/nav_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
