<?xml version="1.0" encoding="utf-8"?>
<!-- Several items of a section, drawn side by side at its top instead of a row each. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glass_menu_icons"
    android:layout_width="match_parent"
    android:layout_height="@dimen/glass_menu_icon_row_height"
    android:gravity="center_vertical"
    android:minWidth="@dimen/glass_menu_min_width"
    android:orientation="horizontal"
    android:paddingStart="@dimen/glass_menu_icon_row_padding"
    android:paddingEnd="@dimen/glass_menu_icon_row_padding" />
