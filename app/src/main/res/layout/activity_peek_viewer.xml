<?xml version="1.0" encoding="utf-8"?>
<!--
    The peek viewer: the media, whether it is selected, and the strip to move along. Deliberately
    nothing else - no toolbar, no heading, no bottom actions, no metadata sheet. See
    PeekViewerActivity.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/peek_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- nothing below it here, so it sits on the navigation bar rather than on the buttons -->
    <org.fossify.gallery.views.ViewerThumbnailStrip
        android:id="@+id/viewer_thumbnail_strip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/viewer_strip_height"
        android:layout_alignParentBottom="true"
        android:paddingTop="@dimen/viewer_strip_padding_top"
        android:paddingBottom="@dimen/viewer_strip_padding_bottom" />

    <!-- an AppBarLayout carrying a single pill, because BaseViewerActivity is what pads one clear
         of the status bar and the notch -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/peek_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:elevation="0dp">

        <org.fossify.gallery.views.GlassPanel
            android:id="@+id/peek_pill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/peek_pill_height"
            android:layout_margin="@dimen/normal_margin"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/medium_margin"
                android:paddingEnd="@dimen/normal_margin">

                <ImageView
                    android:id="@+id/peek_check"
                    android:layout_width="@dimen/selection_check_size"
                    android:layout_height="@dimen/selection_check_size"
                    android:contentDescription="@null"
                    android:padding="@dimen/tiny_margin"
                    tools:background="@drawable/circle_background"
                    tools:src="@drawable/ic_check_vector" />

                <TextView
                    android:id="@+id/peek_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/medium_margin"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textSize="@dimen/normal_text_size"
                    tools:text="3" />

            </LinearLayout>

        </org.fossify.gallery.views.GlassPanel>

    </com.google.android.material.appbar.AppBarLayout>

</RelativeLayout>
