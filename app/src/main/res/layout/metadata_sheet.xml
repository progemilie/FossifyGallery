<?xml version="1.0" encoding="utf-8"?>
<!--
    Merged into MetadataSheet, which is itself the LinearLayout the bottom sheet behaviour drives.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <!-- the whole strip is the grab area, not just the bar drawn in it -->
    <FrameLayout
        android:id="@+id/metadata_sheet_handle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/metadata_sheet_handle_height"
        android:contentDescription="@string/metadata_title">

        <View
            android:id="@+id/metadata_sheet_handle_bar"
            android:layout_width="@dimen/metadata_sheet_handle_width"
            android:layout_height="@dimen/metadata_sheet_handle_thickness"
            android:layout_gravity="center"
            android:background="@drawable/metadata_sheet_handle" />

    </FrameLayout>

    <!-- clips to its padding on purpose: the bottom padding is the navigation bar's, and the
         resting sheet is exactly tall enough to show the summary, so anything below it has to stop
         at that edge rather than bleed through behind the buttons -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/metadata_sheet_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- everything the resting sheet shows, measured as one piece to work out how tall it
                 comes to rest; the navigation bar strip is padding on this rather than extra peek,
                 since a collapsed sheet shows its own top peekHeight pixels -->
            <LinearLayout
                android:id="@+id/metadata_sheet_peek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- pinned open: the fields worth reading before anything is expanded -->
                <LinearLayout
                    android:id="@+id/metadata_sheet_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/normal_margin"
                    android:paddingBottom="@dimen/medium_margin" />

                <!-- sits on the bottom edge of the resting sheet, which is the whole point of it:
                     the last thing read before the fold says there is something below it -->
                <LinearLayout
                    android:id="@+id/metadata_sheet_more_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/normal_margin"
                    android:paddingBottom="@dimen/small_margin">

                    <ImageView
                        android:id="@+id/metadata_sheet_more_hint_icon"
                        android:layout_width="@dimen/metadata_hint_icon_size"
                        android:layout_height="@dimen/metadata_hint_icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_up_vector" />

                    <TextView
                        android:id="@+id/metadata_sheet_more_hint_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/tiny_margin"
                        android:text="@string/metadata_more_hint"
                        android:textSize="@dimen/smaller_text_size"
                        tools:ignore="TextContrastCheck" />

                </LinearLayout>

            </LinearLayout>

            <!-- marks where the pinned rows stop and the collapsed groups start; tinted at runtime -->
            <View
                android:id="@+id/metadata_sheet_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/normal_margin" />

            <!-- the one thing on the sheet that writes rather than reads, so it is kept out of the
                 pinned summary above: it belongs to nobody who only came to read. First below the
                 fold rather than past every section, so extending the sheet at all is enough to
                 reach it. Gone unless the file has something removable in it -->
            <LinearLayout
                android:id="@+id/metadata_sheet_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/metadata_sheet_strip_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/metadata_section_header_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/normal_margin"
                    android:paddingVertical="@dimen/small_margin">

                    <ImageView
                        android:id="@+id/metadata_sheet_strip_icon"
                        android:layout_width="@dimen/normal_icon_size"
                        android:layout_height="@dimen/normal_icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_policy_outline_vector" />

                    <TextView
                        android:id="@+id/metadata_sheet_strip_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/normal_margin"
                        android:text="@string/metadata_remove"
                        android:textSize="@dimen/normal_text_size"
                        android:textStyle="bold"
                        tools:ignore="TextContrastCheck" />

                </LinearLayout>

                <!-- separates the action from the groups listed under it; tinted at runtime -->
                <View
                    android:id="@+id/metadata_sheet_strip_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/normal_margin" />

            </LinearLayout>

            <!-- one collapsed section per group the file carries -->
            <LinearLayout
                android:id="@+id/metadata_sheet_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/metadata_sheet_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/normal_margin"
                android:text="@string/metadata_reading"
                android:textSize="@dimen/normal_text_size"
                tools:ignore="TextContrastCheck" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</merge>
