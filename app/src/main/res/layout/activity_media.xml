<?xml version="1.0" encoding="utf-8"?>
<!--
    The scaffold: a pane of content filling the window, with the search bar floating over the top of
    it and the navigation pill over the foot. Draw order is what makes that work, so the chrome comes
    after the content holder rather than before it, the pill last of all.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/media_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- what the glass copies, and what a pane swap moves inside -->
    <FrameLayout
        android:id="@+id/content_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/media_pane"
            layout="@layout/pane_media_grid" />
    </FrameLayout>

    <org.fossify.commons.views.MySearchMenu
        android:id="@+id/media_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/nav_pill"
        layout="@layout/nav_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
