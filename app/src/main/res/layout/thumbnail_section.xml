<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/thumbnail_section_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/activity_margin">

    <!-- up only while a selection is on; see MediaAdapter.updateSectionChecks -->
    <ImageView
        android:id="@+id/thumbnail_section_check"
        android:layout_width="@dimen/selection_check_size"
        android:layout_height="@dimen/selection_check_size"
        android:layout_marginEnd="@dimen/section_check_gap"
        android:background="@drawable/circle_outline"
        android:contentDescription="@string/select_all"
        android:padding="@dimen/tiny_margin"
        android:visibility="gone"
        tools:visibility="visible" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/thumbnail_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:textSize="@dimen/bigger_text_size" />
</LinearLayout>
