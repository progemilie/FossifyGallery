<?xml version="1.0" encoding="utf-8"?>
<!--
    TEMPORARY: the outline lab, see OutlineLabDialog. The preview stays in view above the options: the
    reorder mode's Save over a photo, and a cover in each of the styles that carries an outline.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/outline_lab_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/outline_lab_pill_backdrop"
        android:layout_width="match_parent"
        android:layout_height="@dimen/outline_lab_backdrop_height"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginTop="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:clipChildren="false">

        <!-- cropped by itself: the backdrop leaves its children unclipped for the pill's glow -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cropToPadding="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/sample_cover_coast" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="@dimen/glass_menu_shadow_room">

            <org.fossify.gallery.views.GlassPanel
                android:id="@+id/outline_lab_pill"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/nav_pill_height">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingEnd="@dimen/bigger_margin"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:id="@+id/outline_lab_pill_icon"
                        android:layout_width="@dimen/nav_pill_icon_size"
                        android:layout_height="@dimen/nav_pill_icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_vector" />

                    <TextView
                        android:id="@+id/outline_lab_pill_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/medium_margin"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/save"
                        android:textSize="@dimen/normal_text_size" />

                </LinearLayout>
            </org.fossify.gallery.views.GlassPanel>
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/outline_lab_covers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/medium_margin"
        android:paddingTop="@dimen/small_margin"
        android:paddingEnd="@dimen/medium_margin"
        android:paddingBottom="@dimen/small_margin" />

    <include layout="@layout/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/activity_margin"
            android:paddingEnd="@dimen/activity_margin"
            android:paddingBottom="@dimen/medium_margin">

            <RadioGroup
                android:id="@+id/outline_lab_surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:orientation="horizontal">

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/outline_lab_surface_pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingBottom="@dimen/medium_margin"
                    android:text="@string/outline_lab_pill" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/outline_lab_surface_covers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingBottom="@dimen/medium_margin"
                    android:text="@string/outline_lab_covers" />

            </RadioGroup>

            <org.fossify.commons.views.MyAppCompatCheckbox
                android:id="@+id/outline_lab_match"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/medium_margin"
                android:paddingBottom="@dimen/medium_margin"
                android:text="@string/outline_lab_covers_match_pill" />

            <org.fossify.commons.views.MyAppCompatCheckbox
                android:id="@+id/outline_lab_photo_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/medium_margin"
                android:paddingBottom="@dimen/medium_margin"
                android:text="@string/outline_lab_photo_color" />

            <LinearLayout
                android:id="@+id/outline_lab_stepper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/outline_lab_previous"
                    android:layout_width="@dimen/outline_lab_step_size"
                    android:layout_height="@dimen/outline_lab_step_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/outline_lab_previous"
                    android:gravity="center"
                    android:text="@string/outline_lab_previous_symbol"
                    android:textSize="@dimen/outline_lab_step_text_size" />

                <LinearLayout
                    android:id="@+id/outline_lab_style_holder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/small_margin"
                    android:paddingBottom="@dimen/small_margin">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/outline_lab_style_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/big_text_size"
                        android:textStyle="bold"
                        tools:text="Soft glow" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/outline_lab_style_position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:textSize="@dimen/smaller_text_size"
                        tools:text="4 of 13 · tap for the list" />

                </LinearLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/outline_lab_next"
                    android:layout_width="@dimen/outline_lab_step_size"
                    android:layout_height="@dimen/outline_lab_step_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/outline_lab_next"
                    android:gravity="center"
                    android:text="@string/outline_lab_next_symbol"
                    android:textSize="@dimen/outline_lab_step_text_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/outline_lab_sliders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/outline_lab_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/medium_margin"
                android:text="@string/outline_lab_reset" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
