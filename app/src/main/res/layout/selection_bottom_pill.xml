<?xml version="1.0" encoding="utf-8"?>
<!--
    What a selection can be done with, along the foot of the screen rather than crowded into the top
    of it. Built to the navigation pill's own measurements - the same height, the same corners, the
    same padding and the same segments - since the two stand in the same place and one gives way to
    the other. See SelectionPills.

    The buttons are filled in at runtime from the action mode's menu; the menu segment on the end is
    a fixture, so the drop-down it opens is built once rather than on every tap.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/selection_bottom_frame"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/glass_menu_shadow_room"
    android:visibility="gone">

    <org.fossify.gallery.views.GlassPanel
        android:id="@+id/selection_bottom_panel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/nav_pill_height">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="@dimen/nav_pill_row_padding">

            <LinearLayout
                android:id="@+id/selection_actions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

            <org.fossify.gallery.views.NavPillSegment
                android:id="@+id/selection_more"
                android:layout_width="@dimen/selection_action_width"
                android:layout_height="match_parent"
                android:clickable="true"
                android:contentDescription="@string/nav_menu"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/selection_more_icon"
                    android:layout_width="@dimen/nav_pill_icon_size"
                    android:layout_height="@dimen/nav_pill_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_menu_lines_vector" />
            </org.fossify.gallery.views.NavPillSegment>
        </LinearLayout>
    </org.fossify.gallery.views.GlassPanel>
</FrameLayout>
